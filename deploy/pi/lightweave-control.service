[Unit]
Description=Lightweave field control plane
Documentation=https://github.com/moda-labs/lightweave/tree/main/deploy/pi
Wants=network-online.target lightweave-provisioner.service
Requires=lightweave-gitops-recovery.service
After=network-online.target lightweave-gitops-recovery.service

[Service]
Type=simple
User=lightweave
Group=lightweave
SupplementaryGroups=dialout audio
WorkingDirectory=/opt/lightweave
EnvironmentFile=/etc/lightweave/control.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=CONTROL_DEPLOYMENT_RECORD=/var/lib/lightweave-gitops/current.json
Environment=CONTROL_OTA_LOCK=/var/lib/lightweave-gitops/firmware-ota.lock
Environment=CONTROL_RELEASE_COMMIT_FILE=/var/lib/lightweave-gitops/running-commit
Environment=CONTROL_SOLIX_STATUS_FILE=/var/lib/lightweave-solix/solix-s2000.json
ExecStartPre=/usr/bin/test -x /usr/bin/mpg123
ExecStartPre=/opt/lightweave/.venv/bin/python -m control.audio_player check
ExecStart=/opt/lightweave/.venv/bin/python -m uvicorn control.app:app --host 127.0.0.1 --port 8000 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=180

StateDirectory=lightweave
StateDirectoryMode=0700
ReadWritePaths=/var/lib/lightweave
ReadOnlyPaths=-/var/lib/lightweave-gitops -/var/lib/lightweave-solix
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
