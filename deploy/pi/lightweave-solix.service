[Unit]
Description=Lightweave SOLIX S2000 Anker cloud MQTT power probe
Documentation=https://github.com/moda-labs/lightweave/tree/main/deploy/pi
Wants=network-online.target
Requires=lightweave-gitops-recovery.service
After=network-online.target lightweave-gitops-recovery.service
PartOf=lightweave-control.service

[Service]
Type=simple
User=lightweave
Group=lightweave
WorkingDirectory=/opt/lightweave
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/lightweave/solix.env
ExecStart=/opt/lightweave/.venv/bin/python -m control.solix_probe --status-file /var/lib/lightweave/power/solix-s2000.json
Restart=always
RestartSec=10

StateDirectory=lightweave/power
StateDirectoryMode=0700
ReadWritePaths=/var/lib/lightweave/power
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
