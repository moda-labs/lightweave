# Install as /etc/lightweave/control.env, owned by root:root and mode 0600.
# Replace every REPLACE_* value and control.example.com before starting the
# field service.
CONTROL_CONDUCTOR=serial
CONTROL_SERIAL_PORT=/dev/serial/by-path/REPLACE_WITH_CONDUCTOR_PATH
CONTROL_SERIAL_RESET_ON_OPEN=0
CONTROL_SERIAL_TIMEOUT_S=8.0
CONTROL_DATA_DIR=/var/lib/lightweave
CONTROL_ALLOWED_ORIGINS=https://control.example.com
CONTROL_REQUIRE_HTTPS=true
CONTROL_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
CONTROL_ALLOW_NETWORK_CHANGES=false
