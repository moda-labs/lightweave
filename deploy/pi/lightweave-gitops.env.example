# Install as /etc/lightweave/gitops.env, owned by root:root and mode 0644.
# This file contains no credentials. The Pi only pulls public, hash-pinned releases.
LIGHTWEAVE_GITOPS_CHANNEL_URL=https://raw.githubusercontent.com/underminedsk/lightweave/main/deploy/channels/production.json
LIGHTWEAVE_GITOPS_ALLOWED_REPOSITORY=https://github.com/underminedsk/lightweave.git
LIGHTWEAVE_GITOPS_REPO=/opt/lightweave
LIGHTWEAVE_GITOPS_DATA_DIR=/var/lib/lightweave
LIGHTWEAVE_GITOPS_DEPLOYMENT_DIR=/var/lib/lightweave-gitops
LIGHTWEAVE_GITOPS_BACKUP_DIR=/var/backups/lightweave
LIGHTWEAVE_GITOPS_STABLE_SCRIPT=/usr/local/lib/lightweave/gitops_reconcile.py
LIGHTWEAVE_GITOPS_SYSTEMD_DIR=/etc/systemd/system
LIGHTWEAVE_GITOPS_OTA_LOCK=/var/lib/lightweave-gitops/firmware-ota.lock
LIGHTWEAVE_GITOPS_HEALTH_URL=http://127.0.0.1:8000/api/health
LIGHTWEAVE_GITOPS_SERVICE_USER=lightweave
