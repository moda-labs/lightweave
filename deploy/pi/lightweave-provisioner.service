[Unit]
Description=Lightweave multi-board USB provisioner
Documentation=https://github.com/underminedsk/lightweave/tree/main/deploy/pi
Wants=network-online.target
After=network-online.target lightweave-control.service
PartOf=lightweave-control.service

[Service]
Type=simple
User=lightweave
Group=lightweave
SupplementaryGroups=dialout
WorkingDirectory=/opt/lightweave
EnvironmentFile=/etc/lightweave/control.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PROVISIONER_STATE_DIR=/var/lib/lightweave/provisioner
ExecStart=/opt/lightweave/.venv/bin/python -m uvicorn control.provisioner:app --uds /run/lightweave-provisioner/provisioner.sock --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=180

RuntimeDirectory=lightweave-provisioner
RuntimeDirectoryMode=0700
StateDirectory=lightweave
StateDirectoryMode=0700
ReadWritePaths=/var/lib/lightweave
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
